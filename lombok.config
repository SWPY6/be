# 이 디렉토리가 설정의 최상위다. 상위 디렉토리의 lombok.config를 찾지 않는다.
config.stopBubbling = true

# 접근자를 getTicker()가 아니라 ticker()로 생성한다.
# record의 접근자(tradeAt(), close())와 이름 규칙을 맞춰 한 가지 스타일만 쓰기 위해서다.
lombok.accessors.fluent = true

# Setter는 쓰지 않는다. 객체는 생성 시점에 완전한 상태여야 하고,
# 상태 변경은 의도가 드러나는 도메인 메서드로 한다.
lombok.setter.flagUsage = ERROR
# @Data는 setter를 만들기 때문에 함께 막는다.
lombok.data.flagUsage = ERROR
